# ---- Required ----
# PostgreSQL connection string (Neon, Supabase, Railway, Vercel Postgres... anything postgres)
DATABASE_URL="postgresql://user:password@host:5432/elhombre?sslmode=require"

# Full public URL of the store (drives SEO canonicals, sitemap.xml, feed.xml, OG images)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Password for /admin (default if unset: noir2024)
ADMIN_PASSWORD="change-me"

# ---- Optional fallbacks (primary place = Admin > Theme Settings > Integrations) ----
# NEXT_PUBLIC_META_PIXEL_ID=""
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
